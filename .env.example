# TMDB "API Read Access Token" (v4 bearer token) from
# https://www.themoviedb.org/settings/api
TMDB_API_READ_ACCESS_TOKEN=""

# SQLite database used by Prisma (path is relative to the project root)
DATABASE_URL="file:./dev.db"

# Inngest: not needed locally when running `pnpm inngest:dev`.
# In production, set these from your Inngest dashboard.
# INNGEST_EVENT_KEY=""
# INNGEST_SIGNING_KEY=""
